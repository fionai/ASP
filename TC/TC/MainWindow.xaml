<Window x:Class="TC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TC"
        mc:Ignorable="d"
        Title="Калькулятор времени" Height="500" Width="600"
        Background="#F3F3F3" FontFamily="Segoe UI">
	<Grid>
		<Grid.RowDefinitions>
			<!-- Верхняя строка для заголовков вкладок и гамбургера, нижняя — для содержимого -->
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Верхняя панель навигации -->
		<Grid Grid.Row="0" Background="#E6E6E6" KeyboardNavigation.TabNavigation="None">
			<Grid.ColumnDefinitions>
				<!-- Левая строго под кнопку  -->
				<ColumnDefinition Width="45"/>
				<!-- Правая колонка под горизонтальные закладки -->
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- 1. Кнопка-Гамбургер -->
			<Button Grid.Column="0" x:Name="HamburgerButton" Content="☰" FontSize="20" Width="45" Height="45" Background="Transparent" BorderThickness="0" Click="MenuButton_Click" IsTabStop="False"/>

			<!-- 2. Выпадающее дублирующее меню (изначально скрыто, всплывает под кнопкой при нажатии) -->
			<Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=HamburgerButton}" Placement="Bottom" StaysOpen="True">
				<Border Background="#E6E6E6" BorderBrush="Gray" BorderThickness="1" Width="160">
					<ListBox x:Name="MenuListBox" Background="Transparent" BorderThickness="0" SelectionChanged="MenuListBox_SelectionChanged">
						<ListBoxItem Content="📅 Разность дат" Height="40" VerticalContentAlignment="Center" Padding="10,0"/>
						<ListBoxItem Content="⏳ Разность времени" Height="40" VerticalContentAlignment="Center" Padding="10,0"/>
						<ListBoxItem Content="🔄 Конвертер" Height="40" VerticalContentAlignment="Center" Padding="10,0"/>
						<ListBoxItem Content="📁 Интервалы" Height="40" VerticalContentAlignment="Center" Padding="10,0"/>
						<ListBoxItem Content="📁 Вкладка 5" Height="40" VerticalContentAlignment="Center" Padding="10,0"/>
					</ListBox>
				</Border>
			</Popup>

			<!-- 3. Закладки с названиями -->
			<ListBox Grid.Column="1" x:Name="TopTabHeaders" Background="Transparent" BorderThickness="0" 
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectedIndex="{Binding SelectedIndex, ElementName=MainTabControl, Mode=TwoWay}"
					 IsTabStop="False" KeyboardNavigation.TabNavigation="None">
				<ListBox.ItemsPanel>
					<ItemsPanelTemplate>
						<!-- Заменили StackPanel на UniformGrid, чтобы распределить вкладки поровну по всей ширине -->
						<UniformGrid Rows="1" VerticalAlignment="Stretch"/>
					</ItemsPanelTemplate>
				</ListBox.ItemsPanel>
				<ListBox.ItemContainerStyle>
					<Style TargetType="ListBoxItem">
						<Setter Property="Padding" Value="5,12"/>
						<Setter Property="FontSize" Value="13"/>
						<Setter Property="HorizontalContentAlignment" Value="Center"/>
						<Setter Property="VerticalContentAlignment" Value="Center"/>
					</Style>
				</ListBox.ItemContainerStyle>

				<ListBoxItem Content="Разность дат"/>
				<ListBoxItem Content="Вкладка 2"/>
				<ListBoxItem Content="Конвертер"/>
				<ListBoxItem Content="Интервалы"/>
				<ListBoxItem Content="Деление"/>
			</ListBox>
		</Grid>

		<!-- Основной контент под меню -->
		<Grid Grid.Row="1" Margin="15">
			<TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0" Margin="0,-4,0,4">
				<!-- Полностью скрываем стандартное оформление TabControl, оставляя только начинку -->
				<TabControl.Resources>
					<Style TargetType="TabItem">
						<Setter Property="Visibility" Value="Collapsed"/>
					</Style>
				</TabControl.Resources>

				<!-- Вкладка 1: Разница дат -->
				<TabItem>
			
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="0.45*"/>
							<ColumnDefinition Width="0.1*"/>
							<ColumnDefinition Width="0.45*"/>
						</Grid.ColumnDefinitions>

						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>	<!-- Заголовок -->
							<RowDefinition Height="Auto"/>	<!-- Надпись 1 -->
							<RowDefinition Height="Auto"/>	<!-- Календарь 1 -->
							<RowDefinition Height="Auto"/>	<!-- Надпись 2 -->
							<RowDefinition Height="Auto"/>	<!-- Календарь 2 -->
							<RowDefinition Height="Auto"/>	<!-- Надпись Результат -->
							<RowDefinition Height="Auto"/>	<!-- Результат -->
						</Grid.RowDefinitions>

						<!-- Заголовок вкладки (растянут на обе колонки) -->
						<TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Вычисление разницы между датами" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>

						<!-- дата 1 -->
						<DatePicker Grid.Row="2" Grid.Column="0" x:Name="StartDatePicker"  Margin="0,0,0,15" SelectedDateChanged="CalculateDateDifference" HorizontalAlignment="Stretch" FontSize="20" Loaded="StartDatePicker_Loaded" />

						<!-- дата 2 -->
						<DatePicker Grid.Row="4" Grid.Column="0" x:Name="EndDatePicker" Margin="0,0,0,15" SelectedDateChanged="CalculateDateDifference" HorizontalAlignment="Stretch" FontSize="20"/>

						<!-- Блок вывода результата -->
						<TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text="Результат:" FontWeight="SemiBold" Margin="0,10,0,5" FontSize="20"/>
						<TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" x:Name="DateResultText" Text=" " FontSize="20" Foreground="#0078D4" TextWrapping="Wrap"/>
					</Grid>
				</TabItem>

				<!-- Вкладка 2: Пустая -->
				<TabItem>
					<Grid>
						<TextBlock Text="Вкладка 2 (Пусто)" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="Gray"/>
					</Grid>
				</TabItem>

				<!-- Вкладка 3: Конвертер -->
				<TabItem>
					<!-- ScrollViewer, при нехватке высоты появляется прокрутка -->
					<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="*"/>
							</Grid.RowDefinitions>

							<TextBlock Grid.Row="0" Text="Конвертер единиц времени" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>

							<!-- Сетка основного контента: 30% | 10% | 60% -->
							<Grid Grid.Row="1">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="0.30*"/>
									<ColumnDefinition Width="0.10*"/>
									<ColumnDefinition Width="0.60*"/>
								</Grid.ColumnDefinitions>

								<!-- ================= ЛЕВАЯ ЧАСТЬ (45%) ================= -->
								<StackPanel Grid.Column="0">
									<ComboBox x:Name="FromUnit" SelectedIndex="0" Margin="0,0,0,15" Padding="5" FontSize="16" SelectionChanged="ConvertTime">
										<ComboBoxItem Content="Секунды"/>
										<ComboBoxItem Content="Минуты"/>
										<ComboBoxItem Content="Часы"/>
										<ComboBoxItem Content="Недели"/>
										<ComboBoxItem Content="Месяцы"/>
										<ComboBoxItem Content="Годы"/>
									</ComboBox>

									<TextBox x:Name="InputValue" Padding="8" FontSize="18" TextWrapping="Wrap" AcceptsReturn="True" TextChanged="ConvertTime"/>
								</StackPanel>

								<!-- ================= СЕРЕДИНА (10%) ================= -->
								<Grid Grid.Column="1"/>

								<!-- ================= ПРАВАЯ ЧАСТЬ (45%) ================= -->
								<StackPanel Grid.Column="2">
									<Grid Grid.IsSharedSizeScope="True">
										<!-- 1. Определяем стиль кнопки внутри Grid -->
										<Grid.Resources>
											<Style x:Key="CopyButtonStyle" TargetType="Button">
												<Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
												<Setter Property="Content" Value="&#xE8C8;"/>
												<Setter Property="FontSize" Value="11"/>
												<Setter Property="Width" Value="24"/>
												<Setter Property="Height" Value="24"/>
												<Setter Property="VerticalAlignment" Value="Top"/>
												<Setter Property="HorizontalAlignment" Value="Right"/>
												<Setter Property="Margin" Value="5,2,0,0"/>
												<Setter Property="Background" Value="#F0F0F0"/>
												<Setter Property="BorderBrush" Value="#CCCCCC"/>
												<Setter Property="BorderThickness" Value="1"/>
												<Setter Property="Foreground" Value="#555555"/>
												<Setter Property="Cursor" Value="Hand"/>
												<Setter Property="ToolTip" Value="Копировать"/>
												<Style.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter Property="Background" Value="#E5E5E5"/>
														<Setter Property="BorderBrush" Value="#A0A0A0"/>
														<Setter Property="Foreground" Value="#000000"/>
													</Trigger>
												</Style.Triggers>
											</Style>
										</Grid.Resources>

										<!-- 2. ОПРЕДЕЛЕНИЕ КОЛОНОК И СТРОК -->
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup"/>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="35"/>
										</Grid.ColumnDefinitions>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" MinHeight="35"/>
											<RowDefinition Height="Auto" MinHeight="35"/>
											<RowDefinition Height="Auto" MinHeight="35"/>
											<RowDefinition Height="Auto" MinHeight="35"/>
											<RowDefinition Height="Auto" MinHeight="35"/>
											<RowDefinition Height="Auto" MinHeight="35"/>
										</Grid.RowDefinitions>

										<!-- 3. СОДЕРЖИМОЕ ТАБЛИЦЫ (Каждая строка содержит: Название, Число и Кнопку) -->
										<!-- Секунды -->
										<TextBlock Grid.Row="0" Grid.Column="0" Text="Секунды:" FontSize="14" VerticalAlignment="Top" Margin="0,5,10,0"/>
										<TextBlock Grid.Row="0" Grid.Column="1" x:Name="ResultSeconds" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="#0078D4" VerticalAlignment="Top" Margin="0,3,5,0" TextWrapping="Wrap"/>
										<Button Grid.Row="0" Grid.Column="2" Style="{StaticResource CopyButtonStyle}" Click="CopyResult_Click" Tag="{Binding ElementName=ResultSeconds}"/>

										<!-- Минуты -->
										<TextBlock Grid.Row="1" Grid.Column="0" Text="Минуты:" FontSize="14" VerticalAlignment="Top" Margin="0,5,10,0"/>
										<TextBlock Grid.Row="1" Grid.Column="1" x:Name="ResultMinutes" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="#0078D4" VerticalAlignment="Top" Margin="0,3,5,0" TextWrapping="Wrap"/>
										<Button Grid.Row="1" Grid.Column="2" Style="{StaticResource CopyButtonStyle}" Click="CopyResult_Click" Tag="{Binding ElementName=ResultMinutes}"/>

										<!-- Часы -->
										<TextBlock Grid.Row="2" Grid.Column="0" Text="Часы:" FontSize="14" VerticalAlignment="Top" Margin="0,5,10,0"/>
										<TextBlock Grid.Row="2" Grid.Column="1" x:Name="ResultHours" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="#0078D4" VerticalAlignment="Top" Margin="0,3,5,0" TextWrapping="Wrap"/>
										<Button Grid.Row="2" Grid.Column="2" Style="{StaticResource CopyButtonStyle}" Click="CopyResult_Click" Tag="{Binding ElementName=ResultHours}"/>

										<!-- Недели -->
										<TextBlock Grid.Row="3" Grid.Column="0" Text="Недели:" FontSize="14" VerticalAlignment="Top" Margin="0,5,10,0"/>
										<TextBlock Grid.Row="3" Grid.Column="1" x:Name="ResultWeeks" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="#0078D4" VerticalAlignment="Top" Margin="0,3,5,0" TextWrapping="Wrap"/>
										<Button Grid.Row="3" Grid.Column="2" Style="{StaticResource CopyButtonStyle}" Click="CopyResult_Click" Tag="{Binding ElementName=ResultWeeks}"/>

										<!-- Месяцы -->
										<TextBlock Grid.Row="4" Grid.Column="0" Text="Месяцы:" FontSize="14" VerticalAlignment="Top" Margin="0,5,10,0"/>
										<TextBlock Grid.Row="4" Grid.Column="1" x:Name="ResultMonths" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="#0078D4" VerticalAlignment="Top" Margin="0,3,5,0" TextWrapping="Wrap"/>
										<Button Grid.Row="4" Grid.Column="2" Style="{StaticResource CopyButtonStyle}" Click="CopyResult_Click" Tag="{Binding ElementName=ResultMonths}"/>

										<!-- Годы -->
										<TextBlock Grid.Row="5" Grid.Column="0" Text="Годы:" FontSize="14" VerticalAlignment="Top" Margin="0,5,10,0"/>
										<TextBlock Grid.Row="5" Grid.Column="1" x:Name="ResultYears" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="#0078D4" VerticalAlignment="Top" Margin="0,3,5,0" TextWrapping="Wrap"/>
										<Button Grid.Row="5" Grid.Column="2" Style="{StaticResource CopyButtonStyle}" Click="CopyResult_Click" Tag="{Binding ElementName=ResultYears}"/>
									</Grid>


									<Separator Margin="0,15,0,15" Background="#CCCCCC"/>

									
									<TextBlock x:Name="FullFormattedResult" Text="0&#160;Лет 0&#160;Месяцев 0&#160;Дней 0&#160;Часов 0&#160;Минут 0&#160;Секунд" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#2B579A"/>
								</StackPanel>
							</Grid>
						</Grid>
					</ScrollViewer>
				</TabItem>


				<!-- Вкладка 4: Сумма/разность интервалов -->
				<TabItem>
					<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<!-- Заголовок -->
								<RowDefinition Height="*" />
								<!-- Контент -->
							</Grid.RowDefinitions>

							<!-- Описание стилей кнопок -->
							<Grid.Resources>
								<Style x:Key="IntervalButtonStyle" TargetType="Button">
									<Setter Property="FontSize" Value="14"/>
									<Setter Property="Padding" Value="12,5"/>
									<Setter Property="Background" Value="#F5F5F5"/>
									<Setter Property="BorderBrush" Value="#CCCCCC"/>
									<Setter Property="BorderThickness" Value="1"/>
									<Setter Property="Cursor" Value="Hand"/>
									<Setter Property="IsTabStop" Value="False"/>
									<!-- Исключаем обычные кнопки из перехода по Tab -->
								</Style>

								<Style x:Key="MathButtonStyle" TargetType="Button" BasedOn="{StaticResource IntervalButtonStyle}">
									<Setter Property="FontSize" Value="24"/>
									<Setter Property="FontWeight" Value="SemiBold"/>
									<Setter Property="Width" Value="60"/>
									<Setter Property="Height" Value="45"/>
									<Setter Property="IsTabStop" Value="True"/>
									<!-- Разрешаем Tab для + и - -->
								</Style>

								<Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource IntervalButtonStyle}">
									<Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
									<Setter Property="Content" Value="&#xE8C8;"/>
									<Setter Property="FontSize" Value="11"/>
									<Setter Property="Width" Value="32"/>
									<Setter Property="Height" Value="28"/>
									<Setter Property="Padding" Value="0"/>
									<Setter Property="IsTabStop" Value="False"/>
								</Style>
							</Grid.Resources>

							<TextBlock Grid.Row="0" Text="Сумма/разность интервалов" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>

							<Grid Grid.Row="1">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="140"/>
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>

								<!-- Результат-->								
								<StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,25" VerticalAlignment="Center">
									<TextBlock x:Name="IntervalResultText" Text="0 д 0 ч 0 мин 0 с" FontSize="20" FontWeight="SemiBold" Foreground="#0078D4" VerticalAlignment="Center" Margin="0,0,15,0"/>
									<Button Style="{StaticResource IconButtonStyle}" Click="CopyIntervalResult_Click" ToolTip="Copy"/>
								</StackPanel>
								<Button Grid.Row="0" Grid.Column="1" Content="Очистить" Style="{StaticResource IntervalButtonStyle}" Click="ClearResult_Click" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,25"/>

								<!-- Ввод интервала -->
								<StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,25">
									<!-- Поля ввода с последовательным TabIndex -->
									<TextBox x:Name="InputIntervalDays" FontSize="18" Padding="6" Width="60" TabIndex="1" VerticalAlignment="Center"/>
									<TextBlock Text="д" FontSize="16" VerticalAlignment="Center" Margin="5,0,15,0"/>

									<TextBox x:Name="InputIntervalHours" FontSize="18" Padding="6" Width="60" TabIndex="2" VerticalAlignment="Center"/>
									<TextBlock Text="ч" FontSize="16" VerticalAlignment="Center" Margin="5,0,15,0"/>

									<TextBox x:Name="InputIntervalMinutes" FontSize="18" Padding="6" Width="60" TabIndex="3" VerticalAlignment="Center"/>
									<TextBlock Text="мин" FontSize="16" VerticalAlignment="Center" Margin="5,0,15,0"/>

									<TextBox x:Name="InputIntervalSeconds" FontSize="18" Padding="6" Width="60" TabIndex="4" VerticalAlignment="Center"/>
									<TextBlock Text="с" FontSize="16" VerticalAlignment="Center" Margin="5,0,0,0"/>
								</StackPanel>
								<Button Grid.Row="1" Grid.Column="1" Content="Очистить" Style="{StaticResource IntervalButtonStyle}" Click="ClearInputFields_Click" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,25"/>

								<!-- Кнопки + - -->
								<StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,5,0,0">
									<Button Content="+" Style="{StaticResource MathButtonStyle}" Click="AddInterval_Click" TabIndex="5" Margin="0,0,15,0"/>
									<Button Content="-" Style="{StaticResource MathButtonStyle}" Click="SubtractInterval_Click" TabIndex="6"/>
								</StackPanel>
							</Grid>
						</Grid>
					</ScrollViewer>
				</TabItem>



				<!-- Вкладка 5: Пустая -->
				<TabItem>
					<Grid>
						<TextBlock Text="Вкладка 5 (Пусто)" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="Gray"/>
					</Grid>
				</TabItem>
			</TabControl>
		</Grid>
	</Grid>
</Window>
