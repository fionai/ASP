<Window x:Class="TC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TC"
        mc:Ignorable="d"
        Title="Калькулятор времени" Height="500" Width="600"
        Background="#F3F3F3" FontFamily="Segoe UI">
	<Grid>
		<Grid.RowDefinitions>
			<!-- Верхняя строка для заголовков вкладок и гамбургера, нижняя — для содержимого -->
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Верхняя панель навигации -->
		<Grid Grid.Row="0" Background="#E6E6E6">
			<Grid.ColumnDefinitions>
				<!-- Левая专栏 строго под кнопку ☰ -->
				<ColumnDefinition Width="45"/>
				<!-- Правая колонка под горизонтальные закладки -->
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- 1. Кнопка-Гамбургер (слева сверху) -->
			<Button Grid.Column="0" x:Name="HamburgerButton" Content="☰" FontSize="20" Width="45" Height="45" Background="Transparent" BorderThickness="0" Click="MenuButton_Click"/>

			<!-- 2. Выпадающее дублирующее меню (изначально скрыто, всплывает под кнопкой при нажатии) -->
			<Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=HamburgerButton}" Placement="Bottom" StaysOpen="True">
				<Border Background="#E6E6E6" BorderBrush="Gray" BorderThickness="1" Width="160">
					<ListBox x:Name="MenuListBox" Background="Transparent" BorderThickness="0" SelectionChanged="MenuListBox_SelectionChanged">
						<ListBoxItem Content="📅 Вычислить разность" Height="40" VerticalContentAlignment="Center" Padding="10,0"/>
						<ListBoxItem Content="⏳ Вкладка 2" Height="40" VerticalContentAlignment="Center" Padding="10,0"/>
						<ListBoxItem Content="🔄 Конвертер" Height="40" VerticalContentAlignment="Center" Padding="10,0"/>
						<ListBoxItem Content="📁 Вкладка 4" Height="40" VerticalContentAlignment="Center" Padding="10,0"/>
						<ListBoxItem Content="📁 Вкладка 5" Height="40" VerticalContentAlignment="Center" Padding="10,0"/>
					</ListBox>
				</Border>
			</Popup>

			<!-- 3. Настоящие видимые закладки с названиями (сверху) -->
			<!-- Отключен горизонтальный скроллбар, чтобы полоса исчезла -->
			<ListBox Grid.Column="1" x:Name="TopTabHeaders" Background="Transparent" BorderThickness="0" 
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectedIndex="{Binding SelectedIndex, ElementName=MainTabControl, Mode=TwoWay}">
				<ListBox.ItemsPanel>
					<ItemsPanelTemplate>
						<!-- Заменили StackPanel на UniformGrid, чтобы распределить вкладки поровну по всей ширине -->
						<UniformGrid Rows="1" VerticalAlignment="Stretch"/>
					</ItemsPanelTemplate>
				</ListBox.ItemsPanel>
				<ListBox.ItemContainerStyle>
					<Style TargetType="ListBoxItem">
						<Setter Property="Padding" Value="5,12"/>
						<Setter Property="FontSize" Value="13"/>
						<Setter Property="HorizontalContentAlignment" Value="Center"/>
						<Setter Property="VerticalContentAlignment" Value="Center"/>
					</Style>
				</ListBox.ItemContainerStyle>

				<ListBoxItem Content="Разность"/>
				<ListBoxItem Content="Вкладка 2"/>
				<ListBoxItem Content="Конвертер"/>
				<ListBoxItem Content="Вкладка 4"/>
				<ListBoxItem Content="Вкладка 5"/>
			</ListBox>
		</Grid>

		<!-- Основной контент под меню -->
		<Grid Grid.Row="1" Margin="15">
			<TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0">
				<!-- Полностью скрываем стандартное оформление TabControl, оставляя только начинку -->
				<TabControl.Resources>
					<Style TargetType="TabItem">
						<Setter Property="Visibility" Value="Collapsed"/>
					</Style>
				</TabControl.Resources>

				<!-- Вкладка 1: Разница дат -->
				<TabItem>
			
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="0.45*"/>
							<ColumnDefinition Width="0.1*"/>
							<ColumnDefinition Width="0.45*"/>
						</Grid.ColumnDefinitions>

						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>	<!-- Заголовок -->
							<RowDefinition Height="Auto"/>	<!-- Надпись 1 -->
							<RowDefinition Height="Auto"/>	<!-- Календарь 1 -->
							<RowDefinition Height="Auto"/>	<!-- Надпись 2 -->
							<RowDefinition Height="Auto"/>	<!-- Календарь 2 -->
							<RowDefinition Height="Auto"/>	<!-- Надпись Результат -->
							<RowDefinition Height="Auto"/>	<!-- Результат -->
						</Grid.RowDefinitions>

						<!-- Заголовок вкладки (растянут на обе колонки) -->
						<TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Вычисление разницы между датами" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>

						<!-- Элементы первой даты (строго в левой колонке) -->
						<TextBlock Grid.Row="1" Grid.Column="0" Text="Дата" Margin="0,0,0,5" FontSize="20"/>
						<DatePicker Grid.Row="2" Grid.Column="0" x:Name="StartDatePicker"  Margin="0,0,0,15" SelectedDateChanged="CalculateDateDifference" HorizontalAlignment="Stretch" FontSize="20" Loaded="StartDatePicker_Loaded" />

						<!-- Элементы второй даты (строго в левой колонке) -->
						<TextBlock Grid.Row="3" Grid.Column="0" Text="Дата" Margin="0,0,0,5" FontSize="20"/>
						<DatePicker Grid.Row="4" Grid.Column="0" x:Name="EndDatePicker" Margin="0,0,0,15" SelectedDateChanged="CalculateDateDifference" HorizontalAlignment="Stretch" FontSize="20"/>

						<!-- Блок вывода результата -->
						<TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text="Результат:" FontWeight="SemiBold" Margin="0,10,0,5" FontSize="20"/>
						<TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" x:Name="DateResultText" Text=" " FontSize="20" Foreground="#0078D4" TextWrapping="Wrap"/>
					</Grid>
				</TabItem>

				<!-- Вкладка 2: Пустая -->
				<TabItem>
					<Grid>
						<TextBlock Text="Вкладка 2 (Пусто)" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="Gray"/>
					</Grid>
				</TabItem>

				<!-- Вкладка 3: Конвертер -->
				<TabItem>
					<Grid>
						<Grid.RowDefinitions>
							<!-- Верхняя строка под заголовок -->
							<RowDefinition Height="Auto"/>
							<!-- Нижняя строка под основной контент (сетка) -->
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>

						<!-- Сверху заголовок -->
						<TextBlock Grid.Row="0" Text="Конвертер времени" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>

						<!-- Сетка основного контента: 45% | 10% | 45% -->
						<Grid Grid.Row="1">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="0.45*"/>
								<ColumnDefinition Width="0.10*"/>
								<ColumnDefinition Width="0.45*"/>
							</Grid.ColumnDefinitions>

							<!-- ================= ЛЕВАЯ ЧАСТЬ (45%) ================= -->
							<StackPanel Grid.Column="0">
								<TextBlock Text="Выберите единицу измерения:" Margin="0,0,0,5" FontSize="14"/>
								<!-- Выпадающий список с вариантами -->
								<ComboBox x:Name="FromUnit" SelectedIndex="0" Margin="0,0,0,15" Padding="5" FontSize="16" SelectionChanged="ConvertTime">
									<ComboBoxItem Content="Секунды"/>
									<ComboBoxItem Content="Минуты"/>
									<ComboBoxItem Content="Часы"/>
									<ComboBoxItem Content="Недели"/>
									<ComboBoxItem Content="Месяцы"/>
									<ComboBoxItem Content="Годы"/>
								</ComboBox>

								<TextBlock Text="Введите значение (большое число):" Margin="0,0,0,5" FontSize="14"/>
								<!-- Поле ввода для большого числа -->
								<TextBox x:Name="InputValue" Padding="8" FontSize="18" TextWrapping="Wrap" AcceptsReturn="True" TextChanged="ConvertTime"/>
							</StackPanel>

							<!-- ================= СЕРЕДИНА (10%) ================= -->
							<!-- Оставляем пустой по вашему запросу -->
							<Grid Grid.Column="1"/>

							<!-- ================= ПРАВАЯ ЧАСТЬ (45%) ================= -->
							<StackPanel Grid.Column="2">
								<!-- Сетка для выравнивания надписей и результатов на одном уровне -->
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" MinHeight="35"/>
										<RowDefinition Height="Auto" MinHeight="35"/>
										<RowDefinition Height="Auto" MinHeight="35"/>
										<RowDefinition Height="Auto" MinHeight="35"/>
										<RowDefinition Height="Auto" MinHeight="35"/>
										<RowDefinition Height="Auto" MinHeight="35"/>
									</Grid.RowDefinitions>

									<!-- Секунды -->
									<TextBlock Grid.Row="0" Grid.Column="0" Text="Секунды:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
									<TextBlock Grid.Row="0" Grid.Column="1" x:Name="ResultSeconds" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="#0078D4" VerticalAlignment="Center"/>

									<!-- Минуты -->
									<TextBlock Grid.Row="1" Grid.Column="0" Text="Минуты:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
									<TextBlock Grid.Row="1" Grid.Column="1" x:Name="ResultMinutes" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="#0078D4" VerticalAlignment="Center"/>

									<!-- Часы -->
									<TextBlock Grid.Row="2" Grid.Column="0" Text="Часы:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
									<TextBlock Grid.Row="2" Grid.Column="1" x:Name="ResultHours" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="#0078D4" VerticalAlignment="Center"/>

									<!-- Недели -->
									<TextBlock Grid.Row="3" Grid.Column="0" Text="Недели:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
									<TextBlock Grid.Row="3" Grid.Column="1" x:Name="ResultWeeks" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="#0078D4" VerticalAlignment="Center"/>

									<!-- Месяцы -->
									<TextBlock Grid.Row="4" Grid.Column="0" Text="Месяцы:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
									<TextBlock Grid.Row="4" Grid.Column="1" x:Name="ResultMonths" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="#0078D4" VerticalAlignment="Center"/>

									<!-- Годы -->
									<TextBlock Grid.Row="5" Grid.Column="0" Text="Годы:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
									<TextBlock Grid.Row="5" Grid.Column="1" x:Name="ResultYears" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="#0078D4" VerticalAlignment="Center"/>
								</Grid>

								<Separator Margin="0,15,0,15" Background="#CCCCCC"/>

								<!-- Строка развернутого формата -->
								<TextBlock Text="Полный формат времени:" FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>
								<TextBlock x:Name="FullFormattedResult" Text="Лет 0 Месяцев 0 Дней 0 Часов 0 Минут 0 Секунд 0" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#2B579A"/>
							</StackPanel>
						</Grid>
					</Grid>
				</TabItem>


				<!-- Вкладка 4: Пустая -->
				<TabItem>
					<Grid>
						<TextBlock Text="Вкладка 4 (Пусто)" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="Gray"/>
					</Grid>
				</TabItem>

				<!-- Вкладка 5: Пустая -->
				<TabItem>
					<Grid>
						<TextBlock Text="Вкладка 5 (Пусто)" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="Gray"/>
					</Grid>
				</TabItem>
			</TabControl>
		</Grid>
	</Grid>
</Window>
