@page "/Factorial"
@rendermode InteractiveServer

<h3>Factorial</h3>

<input type="number" @bind="n" />
<h3>! = @f</h3>
<button class="btn btn-primary" @onclick="Calculate">Calculate</button>

@code {
	int n = 0;
	int f = 1;
	void Calculate()
	{
		f = 1;
		for (int i=1; i<=n; i++)
		{
			f *= i;
		}
	}
}
